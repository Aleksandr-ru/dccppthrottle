<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <ru.aleksandr.dccppthrottle.view.LockableScrollView
        android:id="@+id/curveScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/text_margin">

            <FrameLayout
                android:id="@+id/curveGraphContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ru.aleksandr.dccppthrottle.view.AdjustableCurveView
                    android:id="@+id/curveGraph"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:fitToContainerHeight="true"
                    android:saveEnabled="false" />

                <include layout="@layout/view_curve_smoothing_toggle" />
            </FrameLayout>
        </LinearLayout>
    </ru.aleksandr.dccppthrottle.view.LockableScrollView>

    <ru.aleksandr.dccppthrottle.view.LockableScrollView
        android:id="@+id/curveControlsScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="@dimen/text_margin">

        <include layout="@layout/view_speed_curve_controls" />
    </ru.aleksandr.dccppthrottle.view.LockableScrollView>
</LinearLayout>

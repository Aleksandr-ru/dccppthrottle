<resources>
    <attr name="value" format="integer" />
    <attr name="hiddenBits" format="integer" />
    <attr name="stringArray" format="reference" />

    <declare-styleable name="PlusMinusView">
        <attr name="value" />
        <attr name="min" format="integer" />
        <attr name="max" format="integer" />
        <attr name="step" format="integer" />
        <attr name="nullable" format="boolean" />
        <attr name="android:enabled" />
    </declare-styleable>

    <declare-styleable name="ByteChipsView">
        <attr name="value" />
        <attr name="hiddenBits" />
        <attr name="stringArray" />
        <attr name="android:enabled" />
    </declare-styleable>

    <declare-styleable name="ByteSwitchView">
        <attr name="value" />
        <attr name="hiddenBits" />
        <attr name="stringArray" />
        <attr name="android:enabled" />
    </declare-styleable>

    <declare-styleable name="AdjustableCurveView">
        <attr name="min" />
        <attr name="max" />
        <attr name="gridStep" format="integer" />
        <attr name="points" format="reference" />
        <attr name="smoothing" format="integer" />
    </declare-styleable>
</resources>
